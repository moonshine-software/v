{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "blank_line_before_statement": {
            "statements": ["return", "throw", "try"]
        },
        "array_indentation": true,
        "method_chaining_indentation": true,
        "no_superfluous_phpdoc_tags": {
            "allow_mixed": true,
            "remove_inheritdoc": true
        },
        "phpdoc_align": {
            "align": "left"
        },
        "phpdoc_separation": true,
        "phpdoc_trim": true,
        "class_attributes_separation": {
            "elements": {
                "const": "one",
                "method": "one",
                "property": "one",
                "trait_import": "none"
            }
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "node_modules",
        "public/build"
    ],
    "notPath": [
        "app/MoonShine/ApiAdmin/Resources",
        "app/MoonShine/ApiAdmin/Configs",
        "app/MoonShine/ApiAdmin/Layouts",
        "#^app/MoonShine/Resources/(?!MoonShineUser/|MoonShineUserRole/)#"
    ]
}
