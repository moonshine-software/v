    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "axios": "^1.21.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
