{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "moonshine-v",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "files": [
        "scripts/install.mjs"
    ],
    "bin": {
        "moonshine-v-install": "scripts/install.mjs"
    },
    "scripts": {
        "build": "vite build",
