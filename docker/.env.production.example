# Copy to docker/.env.production (gitignored), chmod 600, and fill all values.
COMPOSE_PROJECT_NAME=moonshine-production
APP_IMAGE=your-registry/moonshine-api-admin:your-release
WEB_IMAGE=your-registry/moonshine-api-admin-web:your-release
APP_KEY=
APP_URL=https://admin.example.com
APP_PORT=8080
DB_PASSWORD=
REDIS_PASSWORD=
API_ADMIN_HOSTED_MODE=local
API_ADMIN_HOSTED_MCP_ENABLED=false
# Exact ingress/Docker gateway IPs or controlled CIDRs, comma-separated. Never '*'.
API_ADMIN_TRUSTED_PROXIES=
