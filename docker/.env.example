COMPOSE_PROJECT_NAME=moonshine-v

# Host address for the web ports. Keep loopback: this stack runs with APP_DEBUG.
APP_BIND=127.0.0.1
APP_PORT=8080
HTTPS_PORT=8443
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=debug
API_ADMIN_LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moonshine_v
DB_USERNAME=moonshine_v
DB_PASSWORD=moonshine_v
POSTGRES_PORT=5432

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_HOST_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === Angie TLS / ACME ===
# Local defaults use 8080/8443. For public HTTP-01 certificate issuance:
# 1. Set APP_PORT=80 and HTTPS_PORT=443.
# 2. Copy docker/angie/conf.d/tls-acme.conf.example to tls-acme.conf.
# 3. Replace example.com/admin@example.com in tls-acme.conf.
# 4. Validate with Let's Encrypt staging before switching to production.

# Example upstream service credentials consumed by generated service configs.
# BLOG_API_URL=https://api.blog.example.com/v1
# BLOG_API_KEY=your-blog-api-key
# SHOP_API_URL=https://api.shop.example.com/api
# SHOP_API_KEY=your-shop-api-key
